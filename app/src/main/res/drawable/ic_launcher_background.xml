<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:scaleX="1.19"
        android:scaleY="1.19"
        android:translateX="-48.64"
        android:translateY="-48.64">

        <!-- Square background -->
        <path android:pathData="M0,0H512V512H0Z">

            <!-- Linear lavender gradient -->
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="512"
                    android:endY="512">
                    <item
                        android:offset="0"
                        android:color="#FFF1ECFF" />
                    <item
                        android:offset="1"
                        android:color="#FFCDBFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Subtle radial highlight -->
        <path android:pathData="M0,0H512V512H0Z">

            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="204.8"
                    android:centerY="128"
                    android:gradientRadius="384">
                    <item
                        android:offset="0"
                        android:color="#8CFFFFFF" />
                    <item
                        android:offset="1"
                        android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

    </group>
</vector>
